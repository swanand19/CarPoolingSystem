@model CarPoolingSystem.ViewModels.RideVM

@using (Html.BeginForm("Create", "Rides", FormMethod.Post))
{

    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.RideId)
    @Html.HiddenFor(model => model.DriverId)
    <fieldset>
        <div class="row mt-4">
            <div class="col-sm-2 text-sm-center">
                @Html.LabelFor(model => model.StartLocation, new { @class = "form-label" })
            </div>
            <div class="col-sm-3">
                @Html.EditorFor(model => model.StartLocation, new { htmlAttributes = new { @class = "form-control" } })
                <p>
                    @Html.ValidationMessageFor(model => model.StartLocation, null, new { @class = "text-danger" })
                </p>
            </div>
            <div class="col-sm-1"></div>
            <div class="col-sm-2 text-sm-center">
                @Html.LabelFor(model => model.EndLocation, new { @class = "form-label" })
            </div>
            <div class="col-sm-3">
                @Html.EditorFor(model => model.EndLocation, new { htmlAttributes = new { @class = "form-control" } })
                <p>
                    @Html.ValidationMessageFor(model => model.EndLocation, null, new { @class = "text-danger" })
                </p>
            </div>

            <div class="col-sm-2 text-sm-center">
                @Html.LabelFor(model => model.DepartureTime)
            </div>
            <div class="col-sm-3">
                @Html.EditorFor(model => model.DepartureTime, new { htmlAttributes = new { @class = "form-control" } })
                <p>
                    @Html.ValidationMessageFor(model => model.DepartureTime, null, new { @class = "text-danger" })
                </p>
            </div>
            <div class="col-sm-1"></div>
            <div class="col-sm-2 text-sm-center">
                @Html.LabelFor(model => model.TotalSeats)
            </div>
            <div class="col-sm-3">
                @Html.EditorFor(model => model.TotalSeats, new { htmlAttributes = new { @class = "form-control"}})
                <p>
                    @Html.ValidationMessageFor(model => model.TotalSeats, null, new { @class = "text-danger" })
                </p>
            </div>

            <div class="col-sm-2 text-sm-center">
                @Html.LabelFor(model => model.FarePerSeat)
            </div>
            <div class="col-sm-3">
                @Html.EditorFor(model => model.FarePerSeat, new { htmlAttributes = new { @class = "form-control" }})
                <p>
                    @Html.ValidationMessageFor(model => model.FarePerSeat, null, new { @class = "text-danger" })
                </p>
            </div>
            <div class="col-sm-6"></div>

            <div class="col-sm-12 text-sm-center">
                <button type="submit" class="btn btn-success">Create</button>
            </div>
           
        </div>

    </fieldset>
}

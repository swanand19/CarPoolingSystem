@model CarPoolingSystem.ViewModels.RoleVM
@{
    ViewBag.Title = "Add Role";
}

<fieldset class="mt-4">
    @using (Html.BeginForm("Create", "Roles", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="row mt-2">
            <div class="col-sm-3"></div>
            <div class="col-sm-6 text-sm-center">
                @Html.LabelFor(model => model.Name, new { @class = "form-label" })
                @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                <p>
                    @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
                </p>
            </div>
            <div class="col-sm-3"></div>
        </div>
        <div class="row mt-2">
            <div class="col-sm-12 align-self-sm-center text-sm-center">
                <button type="submit" class="btn btn-success">Create</button>
            </div>
        </div>
        <div class="row mt-2 text-sm-center">
            @if(ViewBag.ErrorMessage != null)
            {
                <div class="text-danger">
                    <ul class="list-unstyled">
                        <li>• @ViewBag.ErrorMessage</li>
                    </ul>
                </div>
            }
        </div>
    }
</fieldset>
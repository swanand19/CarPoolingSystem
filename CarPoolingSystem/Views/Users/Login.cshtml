@model CarPoolingSystem.ViewModels.LoginUserVM
@{
    ViewBag.Title = "Login";
    string returnUrl = Context.Request.Query["ReturnUrl"].ToString();
}

<div class="row mt-4">
    <div class="col-sm-4"></div>
    <div class="col-sm-4 text-sm-center">
        Not registered yet? <a asp-action="Register" asp-controller="Users">Register</a>
    </div>
    <div class="col-sm-4"></div>

    <div class="col-sm-12 text-sm-center mt-2">
        <h2>Login Page</h2>
    </div>
</div>
<fieldset class="mt-4">
    <form asp-action="Login" asp-controller="Users" asp-route-ReturnUrl="@Context.Request.Query["ReturnUrl"]" method="post">
        @Html.AntiForgeryToken()
        
        <div class="row mt-2">
            <div class="col-sm-2"></div>
            <div class="col-sm-4">
                @Html.LabelFor(model => model.UserName, new { @class = "form-label" })
                @Html.TextBoxFor(model => model.UserName, new { @class = "form-control" })
                <p>
                    @Html.ValidationMessageFor(model => model.UserName, null, new { @class = "text-danger" })
                </p>
            </div>
            <div class="col-sm-4">
                @Html.LabelFor(model => model.Password, new { @class = "form-label" })
                @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-control" } })
                <p>
                    @Html.ValidationMessageFor(model => model.Password, null, new { @class = "text-danger" })
                </p>
            </div>
        </div>
        <div class="row mt-2">
            <div class="col-sm-2"></div>
            <div class="col-sm-2">
                @Html.LabelFor(model => model.Remember, new { @class = "form-label" })
                @Html.EditorFor(model => model.Remember, new { @class = "checkbox" })
            </div>
            <div class="col-sm-4 align-self-sm-center text-sm-center">
                <button type="submit" class="btn btn-success">Create</button>
            </div>
        </div>
        <div class="row mt-2 text-sm-center">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="text-danger">
                    <ul class="list-unstyled">
                        @foreach (var error in ViewData.ModelState["Login"].Errors)
                        {
                            <li>• @error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </form>
</fieldset>
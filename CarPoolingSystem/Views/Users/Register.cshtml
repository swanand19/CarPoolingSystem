@model CarPoolingSystem.ViewModels.RegisterUserVM
@{
    ViewBag.Title = "Register";
}

<fieldset>
    <div class="row mt-4">
        <div class="col-sm-4"></div>
        <div class="col-sm-4 text-sm-center">
            Already Registered? <a asp-action="Login" asp-controller="Users">Login</a>
        </div>
        <div class="col-sm-4"></div>

        <div class="col-sm-12 text-sm-center mt-2">
            <h2>Register Page</h2>
        </div>
    </div>
    <fieldset class="mt-1">
        @using (Html.BeginForm("Register", "Users", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="row mt-2">
                <div class="col-sm-1"></div>
                <div class="col-sm-4">
                    @Html.LabelFor(model => model.FullName, new { @class = "form-label" })
                    @Html.TextBoxFor(model => model.FullName, new { @class = "form-control" })
                    <p>
                        @Html.ValidationMessageFor(model => model.FullName, null, new { @class = "text-danger" })
                    </p>
                </div>
                <div class="col-sm-2"></div>
                <div class="col-sm-4">
                    @Html.LabelFor(model => model.Email, new { @class = "form-label" })
                    @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control" } })
                    <p>
                        @Html.ValidationMessageFor(model => model.Email, null, new { @class = "text-danger" })
                    </p>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-sm-1"></div>
                <div class="col-sm-4">
                    @Html.LabelFor(model => model.PhoneNumber, new { @class = "form-label" })
                    @Html.EditorFor(model => model.PhoneNumber, new { htmlAttributes = new { @class = "form-control" } })
                    <p>
                        @Html.ValidationMessageFor(model => model.PhoneNumber, null, new { @class = "text-danger" })
                    </p>
                </div>
                <div class="col-sm-2"></div>
                <div class="col-sm-4">
                    @Html.LabelFor(model => model.UserName, new { @class = "form-label" })
                    @Html.EditorFor(model => model.UserName, new { htmlAttributes = new { @class = "form-control" } })
                    <p>
                        @Html.ValidationMessageFor(model => model.UserName, null, new { @class = "text-danger" })
                    </p>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-sm-1"></div>
                <div class="col-sm-4">
                    @Html.LabelFor(model => model.Password, new { @class = "form-label" })
                    @Html.EditorFor(model => model.Password, new { htmlAttributes = new { @class = "form-control" } })
                    <p>
                        @Html.ValidationMessageFor(model => model.Password, null, new { @class = "text-danger" })
                    </p>
                </div>
                <div class="col-sm-2"></div>
                <div class="col-sm-4">
                    @Html.LabelFor(model => model.ConfirmPassword, new { @class = "form-label" })
                    @Html.EditorFor(model => model.ConfirmPassword, new { htmlAttributes = new { @class = "form-control" } })
                    <p>
                        @Html.ValidationMessageFor(model => model.ConfirmPassword, null, new { @class = "text-danger" })
                    </p>
                </div>
            </div>

            <div class="row mt-2">
                <div class="col-sm-1"></div>
                <div class="col-sm-2">
                    @Html.LabelFor(model => model.IsDriver, new { @class = "form-label" })
                    @Html.EditorFor(model => model.IsDriver, new { @class = "checkbox"})
                </div>
            </div>
            <div class="row mt-2 text-sm-center">
                <div class="align-self-sm-center">
                    <button type="submit" class="btn btn-success">Create</button>
                </div>
            </div>
            <div class="row mt-2 text-sm-center">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="text-danger">
                        <ul class="list-unstyled">
                            @foreach (var error in ViewData.ModelState["Register"].Errors)
                            {
                                <li>• @error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    </fieldset>
</fieldset>
